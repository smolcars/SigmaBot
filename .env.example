# Telegram (required)
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_WEBHOOK_SECRET=replace_with_a_random_secret
BOT_USERNAME=replace_with_bot_username
BOT_NAME=SigmaBot

# Access control. Empty lists deny access.
ALLOWED_USER_IDS=123456789
ALLOWED_GROUP_IDS=-1001234567890
REQUIRE_ALLOWED_GROUP_USER=false

# Optional GitHub issue publishing. Leave all five variables unset to disable it.
# Create one GitHub App installation that can access every mapped repository.
# GITHUB_APP_ID=123456
# GITHUB_APP_INSTALLATION_ID=12345678
# GITHUB_APP_PRIVATE_KEY_BASE64=base64-encoded-github-app-private-key
# GITHUB_REPOSITORIES_JSON={"sigmabot":"smolcars/SigmaBot"}
# ALLOWED_ISSUE_USER_IDS=123456789

# AI (required)
AI_PROVIDER=openai
AI_API_KEY=replace-with-provider-key
AI_MODEL=replace-with-provider-model-id
# For Moonshot, use AI_PROVIDER=moonshot and AI_MODEL=kimi-k3.

# Required only when registering the production webhook.
PUBLIC_URL=https://replace-with-your-app.deno.net

# Optional AI behavior
OPENAI_BASE_URL=https://api.openai.com/v1
# auto assumes official global/regional OpenAI support and uses provider metadata elsewhere.
# true/false forces the behavior.
AI_SUPPORTS_IMAGES=auto
# Provider-native search is available with OpenAI, Moonshot Kimi K3, and Grok.
# Moonshot currently labels web search as being updated and not production-ready.
WEB_SEARCH=false
# Defaults to 131072 for Moonshot K3 and 1024 for other providers.
# AI_MAX_OUTPUT_TOKENS=1024
AI_TIMEOUT_MS=35000
SYSTEM_PROMPT=

# Optional limits
RATE_LIMIT_PER_MINUTE=10
MAX_CONTEXT_MESSAGES=20
MAX_CONTEXT_CHARS=30000
MAX_RETAINED_MESSAGES=100
MAX_MESSAGE_CHARS=12000
MAX_WEBHOOK_BYTES=1000000
MAX_IMAGE_BYTES=5242880
PORT=8000

# Optional local KV path. Omit on Deno Deploy so the assigned database is used.
# KV_PATH=./sigmabot.kv
